# ABDO Creator OS — environment variables (example only — no real secrets)
#
# Copy to `.env` and fill in real values for local dev.
# For Render / Railway / Fly.io, set these in the platform's environment UI instead.

# --- Required ---

# 32-byte (64 hex char) master key used to encrypt user provider API keys.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If unset, the server auto-generates a dev key into .data/master.key — DO NOT use in production.
APP_KEK=

# JWT signing secret. If unset, a dev secret is auto-generated into .data/jwt.key.
JWT_SECRET=

# --- Recommended ---

NODE_ENV=production
PORT=4000
DATABASE_FILE=.data/abdo.sqlite
CLIENT_ORIGIN=https://your-deployed-url.example.com

# Workflow request timeout in ms (default 60000)
WORKFLOW_TIMEOUT_MS=60000

# --- Optional: live research providers (BYOK) ---
# Get a key at https://tavily.com
RESEARCH_TAVILY_KEY=
# Get a key at https://serpapi.com
RESEARCH_SERPAPI_KEY=

# --- Notes for cloud deploys ---
# * APP_KEK is THE most important variable. If you lose it, all stored provider keys are unrecoverable.
# * Back up APP_KEK and DATABASE_FILE together.
# * Render auto-generates APP_KEK and JWT_SECRET when you deploy with render.yaml.
# * For production, set APP_KEK to a real 64-char hex string. Rotate by deploying a new value and accepting that existing encrypted keys become unrecoverable.
